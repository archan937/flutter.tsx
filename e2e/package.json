{
  "name": "flutter-tsx-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end suite: scaffolds real Flutter.tsx projects and builds them with the Flutter toolchain.",
  "license": "MIT",
  "author": "Paul Engel",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "format": "prettier --write .",
