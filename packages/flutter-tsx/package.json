{
  "name": "flutter-tsx",
  "version": "1.0.0-alpha.0",
  "description": "Write Flutter apps in TypeScript + JSX with full IDE autocomplete \u2014 idiomatic TSX transpiles to idiomatic Dart.",
  "keywords": [
    "flutter",
    "dart",
    "tsx",
    "jsx",
    "typescript",
    "cross-platform",
    "transpiler",
    "fsx",
    "bun"
  ],
  "homepage": "https://github.com/archan937/flutter.tsx/tree/master/packages/flutter-tsx#readme",
  "bugs": {
    "url": "https://github.com/archan937/flutter.tsx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archan937/flutter.tsx.git",
    "directory": "packages/flutter-tsx"
  },
  "license": "MIT",
  "author": "Paul Engel",
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "ref/api.json",
    "ref/derived",
    "ref/plugins",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "fsx": "./bin/fsx.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/runtime/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/runtime/jsx-dev-runtime.ts",
    "./compiler": "./src/compiler/transpile.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "extract": "bun scripts/extract-api.ts",
    "extract:plugin": "bun scripts/extract-plugin.ts",
    "generate:plugin": "bun scripts/generate-plugin-types.ts",
    "derive": "bun scripts/derive-slots.ts",
    "generate": "bun scripts/generate-types.ts",
    "examples": "bun scripts/write-examples.ts",
    "docs": "bun scripts/generate-docs.ts",
    "verify:api": "bun scripts/verify-api.ts",
    "lint:extractor": "bun scripts/extractor-quality.ts lint",
    "test:extractor": "bun scripts/extractor-quality.ts test",
    "quality": "bun run typecheck && bun run format && bun run lint && bun run lint:extractor && bun run test:coverage && bun run test:extractor"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
